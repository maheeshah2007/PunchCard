# Copy this file to .env and fill in real values before running the server.

# Google OAuth Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# JWT secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-secret-change-in-production

# Database URL (SQLite for dev; switch to PostgreSQL for production)
DATABASE_URL=sqlite:///./neighborgood.db
# DATABASE_URL=postgresql://user:password@localhost:5432/neighborgood

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173
# CORS_ORIGINS=https://your-app.com,https://www.your-app.com
