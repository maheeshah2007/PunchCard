# Copy this file to .env and fill in real values

# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_BEFORE_PRODUCTION

# Your Google OAuth Client ID (from console.cloud.google.com)
GOOGLE_CLIENT_ID=212855412758-c7guc92ug9eloic9a3ib9eknhrapgni1.apps.googleusercontent.com

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# SQLite for local dev; swap for postgres:// URL in production
DATABASE_URL=sqlite:///./neighborgood.db
